{
  "hosting": {
    "site": "clap-design-system",
    "public": ".",
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "/design.md",
      "**/.*",
      "**/node_modules/**",
      "/temporary-sources/**",
      "/CLAUDE.md"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/clap",
        "type": 302
      },
      {
        "source": "/clap/",
        "destination": "/clap",
        "type": 301
      },
      {
        "source": "/conjugarium/",
        "destination": "/conjugarium",
        "type": 301
      },
      {
        "source": "/surhumains/",
        "destination": "/surhumains",
        "type": 301
      },
      {
        "source": "/observatoire/",
        "destination": "/observatoire",
        "type": 301
      },
      {
        "source": "/layouts/podcast/",
        "destination": "/layouts/podcast",
        "type": 301
      },
      {
        "source": "/layouts/musee/",
        "destination": "/layouts/musee",
        "type": 301
      },
      {
        "source": "/layouts/video/",
        "destination": "/layouts/video",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/clap",
        "destination": "/index.html"
      },
      {
        "source": "/conjugarium",
        "destination": "/conjugarium.html"
      },
      {
        "source": "/surhumains",
        "destination": "/surhumains.html"
      },
      {
        "source": "/observatoire",
        "destination": "/observatoire.html"
      },
      {
        "source": "/layouts/podcast",
        "destination": "/layouts/podcast.html"
      },
      {
        "source": "/layouts/musee",
        "destination": "/layouts/musee.html"
      },
      {
        "source": "/layouts/video",
        "destination": "/layouts/video.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "**/*.@(css|js|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(clap|conjugarium|surhumains|observatoire)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/layouts/*",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
